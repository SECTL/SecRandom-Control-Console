# ─────────────────────────────────────────────────────────────────────────────
# SecRandom 集控 · 自建实例环境变量
#
#   cp .env.example .env && chmod 600 .env     # 里面有密钥，别留在 0644
#
# 这些变量服务端**只从环境读**（不读 appsettings.json）。写错类型不会静默取默认值：
# 非法值直接拒绝启动，并在日志里说明是哪一项 —— 手滑不该变成"看起来启动了"。
#
# ⚠️ 当前状态：自建登录还没做完 —— 服务端现在不含任何身份源，"必需"里没有任何一项。
#    部署出来的实例：控制台首页能打开，登录入口返回 503（auth_not_configured）。
#    自建要用的三种登录方式（本地账号 / 飞书 / 钉钉）正在做，见
#    https://secrandom.sectl.cn/doc/control/self-host 。
# ─────────────────────────────────────────────────────────────────────────────

# ── 选哪个镜像（只给 docker compose 看，服务端不读）─────────────────────────
# 默认从 GHCR 拉官方发布件：ghcr.io/sectl/secrandom-control-console:latest。
# 想钉住某一版就填部署日期（= 版本号，页脚写着哪天就填哪天），升级/回滚都靠它：
# CTRL_IMAGE_TAG=2026.10.07               # 也接受 latest、或具体的 commit sha
# 内网镜像代理 / 自己 build 出来的镜像可以整体换掉镜像名：
# CTRL_IMAGE=registry.example.com/secrandom-control-console

# ── 容器内固定项：由 docker-compose.yml 设置，通常不必在这里重复 ─────────────
# CTRL_DATA_ROOT=/data                    # SQLite、会话、密钥环、初始化配置都在这
# CTRL_LISTEN_URL=http://0.0.0.0:8791     # 容器内必须监听 0.0.0.0，否则端口映射进不来

# ── 身份源：自建三种登录方式（开发中，见上）─────────────────────────────────
# 服务端核心不含任何身份源，登录全靠一个按程序集名加载的模块
# （SecRandom.Control.Identity.<名字>.dll，放在应用目录里）。三种方式对应三个模块：
#
#   local     本地账号：部署者自己设用户名与口令，成员 / 邀请 / 转让全部关闭（单机、内网）
#   feishu    飞书：部署者自建飞书应用，用 open_id 认人，成员功能完整
#   dingtalk  钉钉：同上，在钉钉开放平台创建应用
#
# 装好模块后，用下面这一项点名；不点名时：恰好一个模块自认为已配置就用它，多个都自认为
# 已配置则拒绝启动（避免含糊地认错身份源），一个都没有就正常启动但不提供登录。
# CTRL_AUTH_PROVIDER=
#
# CTRL_SETUP_TOKEN=                 # 首次初始化的首装令牌；不设则启动时打印到日志
# 飞书：部署者须自建飞书应用，把回调地址登记进"重定向 URL"白名单
# CTRL_AUTH_FEISHU_APP_ID=
# CTRL_AUTH_FEISHU_APP_SECRET=
# CTRL_AUTH_FEISHU_REDIRECT_URI=https://control.example.com/api/auth/callback
# CTRL_AUTH_FEISHU_API_BASE=https://accounts.feishu.cn   # Lark 国际版换成对应域名
# 钉钉：同上，在钉钉开放平台创建应用并登记回调
# CTRL_AUTH_DINGTALK_CLIENT_ID=
# CTRL_AUTH_DINGTALK_CLIENT_SECRET=
# CTRL_AUTH_DINGTALK_REDIRECT_URI=https://control.example.com/api/auth/callback

# 生产必须为 true：BFF 会话 cookie 带 Secure 与 __Host- 前缀。
# 本地用 http://127.0.0.1 试跑时才设 false（否则浏览器根本不会回传 cookie）。
CTRL_AUTH_COOKIE_SECURE=true

# ── 可选：会话与节点在线判定 ────────────────────────────────────────────────
# 会话落盘，跨重启存活。这一项决定"多久需要重新走一次授权"，不是"多久被踢下线"。
# CTRL_AUTH_SESSION_LIFETIME=7.00:00:00
# 回身份源复核会话的间隔（会话多久需要重新走一次授权）与问不到身份源时的宽限期。
# 宽限期别设成 0：上游抖动会把正在上课的老师踢出控制台。
# CTRL_AUTH_SESSION_REVALIDATION_INTERVAL=00:05:00
# CTRL_AUTH_SESSION_VERIFICATION_GRACE=01:00:00
# 多久没心跳算离线（默认 75 = 心跳 25 秒 × 3）。只影响在线状态，不影响设备是否在列表里。
# CTRL_NODE_OFFLINE_AFTER_SECONDS=75
# 未注册的设备能否自动登记（默认 true）。关掉即回到"必须先显式注册"。
# CTRL_NODE_AUTO_REGISTER=true

# ── 可选：配额与留存 ────────────────────────────────────────────────────────
# 每个人最多拥有多少个组。
# CTRL_MAX_OWNED_GROUPS_PER_USER=100
# 审计保留天数，默认 30。**早于窗口的记录会被真的删掉**；设 0 = 永久保留，
# 代价是磁盘占用没有上界。
# CTRL_AUDIT_RETENTION_DAYS=30

# ── 可选：策略包签名密钥 ────────────────────────────────────────────────────
# 未设置时签名密钥落在数据根目录下。
# CTRL_SIGNING_KEY_PATH=
